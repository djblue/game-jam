#!/usr/bin/env bash

set -euo pipefail

cd target

if [ ! -f 'linuxdeploy-x86_64.AppImage' ]; then
  curl -LO 'https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/linuxdeploy-x86_64.AppImage'
  chmod +x 'linuxdeploy-x86_64.AppImage'
fi

mkdir -p AppDir/resources

cp -r ../resources/* AppDir/resources

./linuxdeploy-x86_64.AppImage \
  --executable=release/froggy \
  --library="$(c++ -print-file-name=libstdc++.so.6)" \
  --library="$(c++ -print-file-name=libgcc_s.so.1)" \
  --desktop-file=../resources/appimage/froggy.desktop \
  --icon-file=../resources/appimage/icon.png \
  --appdir=AppDir \
  --output appimage