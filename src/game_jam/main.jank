(ns game-jam.main
  (:require [clojure.string :as str])
  (:include "raylib.h"
            "raygui.h"
            "rlgl.h"
            "raymath.h"
            "./src/game_jam/convert.hpp"))

;; TODO:
;; - render frog health
;; - automatic fly spawning
;; - flys should fly after spawn
;;  - should be able to pull tongue?
;; - flys explode after death timer
;;   - lower frog health

;; IDEAS:
;; - bugs that dies will take a part of the health away
;; - bugs you eat will heal you
;; - you goal is to eat more bugs that die to keep yourself alive?

(comment
  (cpp/Vector2Zero)
  (cpp/Vector2Length {:x 1 :y 1}))

(def screen-width 1920)
(def screen-height 1080)
(def deadzone 0.05)

(def initial-state
  {:frog-mouth {:position
                {:x (* 0.5 screen-width)
                 :y (* 0.5 screen-height)}
                :radius 75
                :velocity {:x 0 :y 0}}
   :frog-tongues 1
   :frog-eating #{}
   :frog-health 100
   :fly-ids 0
   :flys {}
   :timer 0
   :dt 0})

(defonce state-atom (atom initial-state))

(comment
  (reset! state-atom initial-state)
  (swap! state-atom assoc :frog-health 0)
  (-> @state-atom)
  comment)

(defn spawn-fly [{:keys [timer fly-ids] :as state}]
  (-> state
      (update :fly-ids inc)
      (update :flys assoc (inc fly-ids)
              {:position
               {:x (int (+ (* 0.8 (rand) screen-width)
                           (* 0.1 screen-width)))
                :y (int (+ (* 0.8 (rand) screen-height)
                           (* 0.1 screen-height)))}
               :velocity
               {:x 0 :y 0}
               :radius 25
               :spawn-time timer})))

(defn get-gamepad []
  (loop [i 0]
    (or (when (and (cpp/IsGamepadAvailable i)
                   (str/includes? (cpp/GetGamepadName i) "Xbox"))
          i)
        (recur (inc i)))))

(defn handle-input [{:keys [dt] :as state}]
  (if (cpp/IsKeyPressed cpp/KEY_R)
    initial-state
    (let [speed (* 0.5 dt screen-width)
          gamepad (int (get-gamepad))
          axis-x (cpp/GetGamepadAxisMovement gamepad 0)
          axis-y (cpp/GetGamepadAxisMovement gamepad 1)]
      (cond-> state
        (or (cpp/IsKeyPressed cpp/KEY_ESCAPE)
            (cpp/IsGamepadButtonPressed gamepad cpp/GAMEPAD_BUTTON_MIDDLE_RIGHT))
        (update :paused? not)

        (or (cpp/IsKeyDown cpp/KEY_UP)
            (cpp/IsKeyDown cpp/KEY_W)
            (cpp/IsGamepadButtonDown gamepad cpp/GAMEPAD_BUTTON_LEFT_FACE_UP))
        (update-in [:frog-mouth :velocity :y] - speed)

        (or (cpp/IsKeyDown cpp/KEY_DOWN)
            (cpp/IsKeyDown cpp/KEY_S)
            (cpp/IsGamepadButtonDown gamepad cpp/GAMEPAD_BUTTON_LEFT_FACE_DOWN))
        (update-in [:frog-mouth :velocity :y] + speed)

        (or (cpp/IsKeyDown cpp/KEY_LEFT)
            (cpp/IsKeyDown cpp/KEY_A)
            (cpp/IsGamepadButtonDown gamepad cpp/GAMEPAD_BUTTON_LEFT_FACE_LEFT))
        (update-in [:frog-mouth :velocity :x] - speed)

        (or (cpp/IsKeyDown cpp/KEY_RIGHT)
            (cpp/IsKeyDown cpp/KEY_D)
            (cpp/IsGamepadButtonDown gamepad cpp/GAMEPAD_BUTTON_LEFT_FACE_RIGHT))
        (update-in [:frog-mouth :velocity :x] + speed)

        (> (abs axis-x) deadzone)
        (update-in [:frog-mouth :velocity :x] + (* axis-x speed))

        (> (abs axis-y) deadzone)
        (update-in [:frog-mouth :velocity :y] + (* axis-y speed))

        (cpp/IsKeyPressed cpp/KEY_SPACE)
        (spawn-fly)))))

(defn wall-x [x]
  (or (< x 0) (> x screen-width)))

(defn wall-y [y]
  (or (< y 0) (> y screen-height)))

(defn intersection [{pa :position ra :radius} {pb :position rb :radius}]
  (cpp/CheckCollisionCircles pa (float ra) pb (float rb)))

(defn frog-max-tongues? [{:keys [frog-tongues frog-eating]}]
  (== frog-tongues (count frog-eating)))

(defn apply-damage [{:keys [flys frog-eating timer] :as state}]
  (reduce-kv
   (fn [state fly-id {:keys [spawn-time]}]
     (cond-> state
       (and (not (contains? frog-eating fly-id))
            (< (+ spawn-time 10) timer))
       (-> (update :flys dissoc fly-id)
           (update :frog-health - 10))))
   state
   flys))

(defn check-flys [{:keys [flys frog-eating frog-mouth timer] :as state}]
  (if (frog-max-tongues? state)
    state
    (reduce-kv
     (fn [state fly-id fly]
       (let [state (cond-> state
                     (and (not (contains? frog-eating fly-id))
                          (intersection fly frog-mouth))
                     (-> (update :frog-eating conj fly-id)
                         (assoc-in [:flys fly-id :eat-timer] timer)))]
         (cond-> state
           (frog-max-tongues? state) reduced)))
     state
     flys)))

(defn clamp-eating [{:keys [frog-eating flys frog-mouth timer] :as state}]
  (reduce
   (fn [state fly-id]
     (let [fly (get flys fly-id)]
       (cond
         (< (+ 1 (:eat-timer fly)) timer)
         (-> state
             (update :frog-eating disj fly-id)
             (update :flys dissoc fly-id))

         (> (cpp/Vector2Distance (:position fly) (:position frog-mouth))
            (* 2.5 (+ (:radius fly) (:radius frog-mouth))))
         (update-in state
                    [:frog-mouth :velocity]
                    (fn [v-mouth]
                      (let [p-mouth (:position frog-mouth)
                            p-fly (:position fly)]
                        (cpp/Vector2Scale
                         (cpp/Vector2Normalize (cpp/Vector2Subtract p-fly p-mouth))
                         (max 1 (* 0.75 (cpp/Vector2Length v-mouth)))))))

         :else state)))
   state
   frog-eating))

(defn update-mouth [{:keys [dt frog-mouth] :as state}]
  (let [{pos :position vel :velocity} frog-mouth
        {px :x py :y :as pos} (cpp/Vector2Add pos (cpp/Vector2Scale vel dt))
        {vx :x vy :y} (cpp/Vector2Subtract
                       vel
                       (cpp/Vector2Scale (cpp/Vector2Normalize vel)
                                         (* 0.25 (cpp/Vector2Length vel) dt)))
        vx (if (wall-x px) (- vx) vx)
        vy (if (wall-y py) (- vy) vy)]
    (update state
            :frog-mouth
            (fn [frog-mouth]
              (assoc frog-mouth :position pos :velocity {:x vx :y vy})))))

(defn apply-physics [state]
  (-> state
      (clamp-eating)
      (update-mouth)
      (check-flys)))

(defn update-time [state]
  (let [dt (cpp/GetFrameTime)]
    (-> state
        (update :timer + dt)
        (assoc :dt dt))))

(defn game-over? [{:keys [frog-health]}] (<= frog-health 0))

(defn update-world [state]
  (let [done? (game-over? state)]
    (cond-> state
      :always handle-input

      (not done?)
      apply-damage

      (and (not done?) (not (:paused? state)))
      (-> update-time apply-physics))))

(defn draw-mouth! [{{p :position r :radius} :frog-mouth}]
  (cpp/DrawCircleV p (float r) (cpp/GetColor 0xff0000ff)))

(defn draw-tongue! [{:keys [frog-eating] {p-mouth :position} :frog-mouth :as state}]
  (doseq [frog-id frog-eating
          :let [{p-fly :position} (get-in state [:flys frog-id])]]
    (cpp/DrawLineEx p-mouth p-fly 5 (cpp/GetColor 0x0000ffff))))

(defn draw-flys! [{:keys [flys timer]}]
  (doseq [[_id {p :position r :radius :keys [spawn-time]}] flys
          :let [time-alive (subs (str (- timer spawn-time)) 0 4)
                text-size 20]]
    (cpp/DrawCircleV p (float r) (cpp/GetColor 0x00ff00ff))
    (cpp/DrawText
     time-alive
     (- (:x p) r)
     (- (:y p) r text-size)
     text-size
     (cpp/GetColor 0xffffffff))))

(defn draw-status! [{:keys [paused? frog-health] :as state}]
  (let [font-size 40
        frog-health-str (str (max frog-health 0))]
    (cpp/DrawText
     (if paused?
       "PAUSED"
       "PLAYING")
     10
     10
     font-size
     (cpp/GetColor 0xffffffff))
    (cpp/DrawText
     frog-health-str
     (int (- (* 0.5 screen-width)
             (* 0.5 (cpp/MeasureText frog-health-str font-size))))
     10
     font-size
     (cpp/GetColor 0xffffffff))
    (let [font-size (int (* 0.15 screen-width))
          label "GAME OVER"]
      (when (game-over? state)
        (cpp/DrawText
         label
         (int (- (* 0.5 screen-width)
                 (* 0.5 (cpp/MeasureText label font-size))))
         (int (- (* 0.5 screen-height)
                 (* 0.5 font-size)))
         font-size
         (cpp/GetColor 0xffffffff))))))

(defn draw-frame! [state]
  (cpp/ClearBackground cpp/BLACK)
  (draw-mouth! state)
  (draw-tongue! state)
  (draw-flys! state)
  (draw-status! state)
  nil)

(defn -main [& args]
  (cpp/InitWindow screen-width screen-height "froggy")
  (cpp/SetTargetFPS 60)
  (cpp/SetExitKey cpp/KEY_NULL)
  (while (cpp/! (cpp/WindowShouldClose))
    (let [next-state (swap! state-atom update-world)]
      (cpp/BeginDrawing)
      (try
        (draw-frame! next-state)
        (catch :default _)))
    (cpp/EndDrawing))
  (cpp/CloseWindow))

(comment
  (def fut (future (-main)))
  (require '[portal.api :as p])
  (p/open {:launcher :auto})
  (add-tap #'p/submit)
  (tap> ::hi))
