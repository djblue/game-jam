(ns game-jam.main
  (:require [clojure.string :as str])
  (:include "raylib.h"
            "raygui.h"
            "rlgl.h"
            "raymath.h"
            "game_jam/convert.hpp"))

(defmacro with-scale [scale & body]
  `(try
     (cpp/rlPushMatrix)
     (cpp/rlScalef ~scale ~scale 1)
     ~@body
     (finally (cpp/rlPopMatrix))))

(defonce assets (atom {}))

(defn load-asset! [{:keys [id path]}]
  (let [image (cpp/LoadImage path)]
    (swap! assets assoc id (cpp/LoadTextureFromImage image))
    (cpp/UnloadImage image)))

(defn load-assets! []
  (load-asset! {:id :teeth-top
                :path "./resources/mouth/teeth-top.png"})
  (load-asset! {:id :teeth-btm
                :path "./resources/mouth/teeth-btm.png"})
  (load-asset! {:id :mouth-hole
                :path "./resources/mouth/mouth-hole.png"})
  (load-asset! {:id :background-fill
                :path "./resources/background/background-fill.png"})
  (load-asset! {:id :pupil-l
                :path "./resources/background/pupil-l.png"})
  (load-asset! {:id :pupil-r
                :path "./resources/background/pupil-r.png"})
  (load-asset! {:id :fly-idle-0
                :path "./resources/fly/idle-0.png"})
  (load-asset! {:id :fly-idle-1
                :path "./resources/fly/idle-1.png"}))

(defn load-gamepad-mappings! []
  (doseq [mapping (str/split-lines (slurp "./resources/gamepad-mappings.txt"))]
    (cpp/SetGamepadMappings mapping)))

;; TODO:
;; - render frog health

(def screen-width 1920)
(def screen-height 1080)
(def deadzone 0.05)

(def pupil-size-half 50)
(def mouth-hole-size-half 105)
(def teeth-width-half 85)
(def teeth-top-outline-offset 12)
(def teeth-btm-outline-offset 68)
(def fly-size 90)

(def frog-start-x 32)
(def frog-end-x 1620)
(def frog-start-y 140)
(def frog-end-y screen-height)

(def frog-mouth-start {:x (+ frog-start-x (* 0.5 (- frog-end-x frog-start-x)))
                       :y (+ frog-start-y (* 0.5 (- frog-end-y frog-start-y)))})

(def initial-state
  {:frog-mouth {:position frog-mouth-start
                :radius 105
                :velocity {:x 0 :y 0}}
   :frog-tongues 1
   :frog-eating #{}
   :frog-health 100
   :fly-ids 0
   :flys {}
   :fly-spawn-timer 2.0
   :fly-spawn-time-count 0 
   :timer 0
   :dt 0})

(defonce state-atom (atom initial-state))

(comment
  (reset! state-atom initial-state)
  (swap! state-atom assoc :frog-health 0)
  (-> @state-atom)
  comment)

(defn spawn-fly [{:keys [timer fly-ids] :as state}]
  (-> state
      (update :fly-ids inc)
      (update :flys assoc (inc fly-ids)
              {:position
               {:x 10 #_(int (+ (* 0.8 (rand) screen-width)
                                (* 0.1 screen-width)))
                :y (int (+ (* 0.6 (rand) screen-height)
                           (* 0.2 screen-height)))}
               :velocity
               {:x 0 #_(- (* (rand) 0.4 screen-width)
                          (* 0.2 screen-width))
                :y 0}
               :radius 50
               :spawn-time timer})))

(defn get-gamepad []
  (loop [i 0]
    (if (> i 10)
      -1
      (or (when (and (cpp/IsGamepadAvailable i)
                     (let [name (cpp/GetGamepadName i)]
                       (or (str/includes? name "Xbox")
                           (str/includes? name "X-Box")
                           (str/includes? name "DualSense"))))
            i)
          (recur (inc i))))))

(defn handle-input [{:keys [dt] :as state}]
  (when (cpp/IsKeyPressed cpp/KEY_F)
    (cpp/ToggleBorderlessWindowed))
  (when (cpp/IsKeyPressed cpp/KEY_ONE)
    (cpp/SetWindowSize 1280 720))
  (when (cpp/IsKeyPressed cpp/KEY_TWO)
    (cpp/SetWindowSize 1920 1080))
  (let [gamepad (int (get-gamepad))]
    (if (or (cpp/IsKeyPressed cpp/KEY_R)
            (cpp/IsGamepadButtonPressed gamepad cpp/GAMEPAD_BUTTON_MIDDLE_LEFT))
      initial-state
      (let [speed (* 0.5 dt screen-width)
            axis-x (cpp/GetGamepadAxisMovement gamepad 0)
            axis-y (cpp/GetGamepadAxisMovement gamepad 1)]
        (cond-> state
          (or (cpp/IsKeyPressed cpp/KEY_ESCAPE)
              (cpp/IsGamepadButtonPressed gamepad cpp/GAMEPAD_BUTTON_MIDDLE_RIGHT))
          (update :paused? not)

          (or (cpp/IsKeyDown cpp/KEY_UP)
              (cpp/IsKeyDown cpp/KEY_W)
              (cpp/IsGamepadButtonDown gamepad cpp/GAMEPAD_BUTTON_LEFT_FACE_UP))
          (update-in [:frog-mouth :velocity :y] - speed)

          (or (cpp/IsKeyDown cpp/KEY_DOWN)
              (cpp/IsKeyDown cpp/KEY_S)
              (cpp/IsGamepadButtonDown gamepad cpp/GAMEPAD_BUTTON_LEFT_FACE_DOWN))
          (update-in [:frog-mouth :velocity :y] + speed)

          (or (cpp/IsKeyDown cpp/KEY_LEFT)
              (cpp/IsKeyDown cpp/KEY_A)
              (cpp/IsGamepadButtonDown gamepad cpp/GAMEPAD_BUTTON_LEFT_FACE_LEFT))
          (update-in [:frog-mouth :velocity :x] - speed)

          (or (cpp/IsKeyDown cpp/KEY_RIGHT)
              (cpp/IsKeyDown cpp/KEY_D)
              (cpp/IsGamepadButtonDown gamepad cpp/GAMEPAD_BUTTON_LEFT_FACE_RIGHT))
          (update-in [:frog-mouth :velocity :x] + speed)

          (> (abs axis-x) deadzone)
          (update-in [:frog-mouth :velocity :x] + (* axis-x speed))

          (> (abs axis-y) deadzone)
          (update-in [:frog-mouth :velocity :y] + (* axis-y speed))

          ;; TODO: Remove dev spawn
          (or (cpp/IsKeyPressed cpp/KEY_SPACE)
              (cpp/IsGamepadButtonPressed gamepad cpp/GAMEPAD_BUTTON_RIGHT_TRIGGER_1))
          (spawn-fly))))))

(defn intersection [{pa :position ra :radius} {pb :position rb :radius}]
  (cpp/CheckCollisionCircles pa (float ra) pb (float rb)))

(defn frog-max-tongues? [{:keys [frog-tongues frog-eating]}]
  (== frog-tongues (count frog-eating)))

(defn apply-damage [{:keys [flys frog-eating timer] :as state}]
  (reduce-kv
   (fn [state fly-id {:keys [spawn-time]}]
     (cond-> state
       (and (not (contains? frog-eating fly-id))
            (< (+ spawn-time 10) timer))
       (-> (update :flys dissoc fly-id)
           (update :frog-health - 10))))
   state
   flys))

(defn spawn-fly-with-timer [{:keys [fly-spawn-time-count fly-spawn-timer dt] :as state}] 
  (if (> fly-spawn-time-count fly-spawn-timer)
    (-> state
      (assoc :fly-spawn-time-count 0)
      (spawn-fly))
    (-> state
        (update :fly-spawn-time-count + dt))))

(defn check-flys [{:keys [flys frog-eating frog-mouth timer] :as state}]
  (if (frog-max-tongues? state)
    state
    (reduce-kv
     (fn [state fly-id fly]
       (let [state (cond-> state
                     (and (not (contains? frog-eating fly-id))
                          (intersection fly frog-mouth))
                     (-> (update :frog-eating conj fly-id)
                         (assoc-in [:flys fly-id :eat-timer] timer)))]
         (cond-> state
           (frog-max-tongues? state) reduced)))
     state
     flys)))

(defn neg [n] (- (abs n)))

(defn wall-bang [{p :position :as e}]
  (let [{px :x py :y} p]
    (cond-> e
      (<= px 0) (update-in [:velocity :x] abs)
      (> px screen-width) (update-in [:velocity :x] neg)
      (<= py 0) (update-in [:velocity :y] abs)
      (> py screen-height) (update-in [:velocity :y] neg))))

(defn route-flys [{:keys [flys frog-eating dt] :as state}]
  (let [speed (* 0.15 screen-width)]
    (reduce-kv
     (fn [state fly-id {p :position v :velocity}]
       (let [p (cpp/Vector2Add p (cpp/Vector2Scale v dt))
             v (cpp/Vector2Scale
                (cpp/Vector2Normalize
                 (cpp/Vector2
                  (float (if (neg? (:x v)) -1 1))
                  (cpp/sin (* 3 2 cpp/PI (/ (:x p) screen-width)))))
                speed)]
         (-> state
             (update-in [:flys fly-id] assoc :position p :velocity v)
             (update-in [:flys fly-id] wall-bang))))
     state
     flys)))

(defn clamp-eating [{:keys [frog-eating flys frog-mouth timer] :as state}]
  (reduce
   (fn [state fly-id]
     (let [fly (get flys fly-id)]
       (cond
         (< (+ 1 (:eat-timer fly)) timer)
         (-> state
             (update :frog-eating disj fly-id)
             (update :flys dissoc fly-id)
             (update :frog-health (fn [h] (min 100 (+ h 10)))))

         (> (cpp/Vector2Distance (:position fly) (:position frog-mouth))
            (* 2.5 (+ (:radius fly) (:radius frog-mouth))))
         (update-in state
                    [:frog-mouth :velocity]
                    (fn [v-mouth]
                      (let [p-mouth (:position frog-mouth)
                            p-fly (:position fly)]
                        (cpp/Vector2Scale
                         (cpp/Vector2Normalize (cpp/Vector2Subtract p-fly p-mouth))
                         (cpp/Vector2Length v-mouth)))))

         :else state)))
   state
   frog-eating))

(defn update-mouth [{:keys [dt frog-mouth] :as state}]
  (let [{p :position v :velocity} frog-mouth]
    (assoc state
           :frog-mouth
           (wall-bang
            (assoc frog-mouth
                   :position (cpp/Vector2Add p (cpp/Vector2Scale v dt))
                   :velocity (cpp/Vector2Subtract
                              v
                              (cpp/Vector2Scale (cpp/Vector2Normalize v)
                                                (* 0.25 (cpp/Vector2Length v) dt))))))))

(defn apply-physics [state]
  (-> state
      (route-flys)
      (clamp-eating)
      (update-mouth)
      (check-flys)))

(defn update-time [state]
  (let [dt (cpp/GetFrameTime)]
    (-> state
        (update :timer + dt)
        (assoc :dt dt))))

(defn game-over? [{:keys [frog-health]}] (<= frog-health 0))

(defn update-world [state]
  (let [done? (game-over? state)]
    (cond-> state
      :always handle-input

      (not done?)
      apply-damage 

      (and (not done?) (not (:paused? state)))
      (-> spawn-fly-with-timer update-time apply-physics))))

(defn draw-background! [_state]
  (cpp/DrawTexture (:background-fill @assets) 0 0 cpp/WHITE))

(defn draw-eyes! [{{p :position} :frog-mouth}]
  (let [left-eye    (cpp/Vector2 518 147)
        right-eye   (cpp/Vector2 1102 147)
        left-pupil  (cpp/Vector2MoveTowards left-eye p 52)
        right-pupil (cpp/Vector2MoveTowards right-eye p 52)]
    (cpp/DrawTexture (:pupil-l @assets) (int (- (.-x left-pupil) pupil-size-half)) (int (- (.-y left-pupil) pupil-size-half)) cpp/WHITE)
    (cpp/DrawTexture (:pupil-r @assets) (int (- (.-x right-pupil) pupil-size-half)) (int (- (.-y right-pupil) pupil-size-half)) cpp/WHITE)))

(defn draw-mouth! [{{p :position r :radius} :frog-mouth}]
  (let [green (cpp/GetColor 0x3e5c30ff)
        light-green (cpp/GetColor 0x679153ff)
        mouth-top-start (cpp/Vector2Subtract frog-mouth-start (cpp/Vector2 0 (+ (float r) 6.0)))
        mouth-top-end (cpp/Vector2Subtract p (cpp/Vector2 0 (+ (float r) 6.0)))
        mouth-bottom-start (cpp/Vector2Add frog-mouth-start (cpp/Vector2 0 (+ (float r) 6.0)))
        mouth-bottom-end (cpp/Vector2Add p (cpp/Vector2 0 (+ (float r) 6.0)))]
    (cpp/DrawTriangle mouth-top-start mouth-top-end mouth-bottom-end light-green)
    (cpp/DrawTriangle mouth-top-start mouth-bottom-end mouth-bottom-start light-green)
    (cpp/DrawTriangle mouth-top-start mouth-bottom-end mouth-top-end light-green)
    (cpp/DrawTriangle mouth-top-start mouth-bottom-start mouth-bottom-end light-green)

    (cpp/DrawLineEx mouth-top-start mouth-top-end 12.0 green)
    (cpp/DrawCircleV mouth-top-start 6.0 green)
    (cpp/DrawLineEx mouth-bottom-start mouth-bottom-end 12.0 green)
    (cpp/DrawCircleV mouth-bottom-start 6.0 green))

  (cpp/DrawCircleV p (+ (float r) 12.0) (cpp/GetColor 0x533b2dff))
  (cpp/DrawCircleV p (float r) (cpp/GetColor 0x845143ff))
  (cpp/DrawTexture (:mouth-hole @assets) (int (- (:x p) mouth-hole-size-half)) (int (- (:y p) mouth-hole-size-half)) cpp/WHITE)
  (cpp/DrawTexture (:teeth-top @assets) (int (- (:x p) teeth-width-half)) (int (- (- (:y p) teeth-top-outline-offset) r)) cpp/WHITE)
  (cpp/DrawTexture (:teeth-btm @assets) (int (- (:x p) teeth-width-half)) (int (+ (- (:y p) teeth-btm-outline-offset) r)) cpp/WHITE))

(defn draw-tongue! [{:keys [timer frog-eating] {p-mouth :position} :frog-mouth :as state}]
  (doseq [frog-id frog-eating
          :let [{eat-timer :eat-timer p-fly :position} (get-in state [:flys frog-id])
                time-to-eat 1
                total-distance (cpp/Vector2Distance p-mouth p-fly)
                linear (/ (- timer eat-timer) time-to-eat)
                length (* (/ (cpp/exp (* 20 linear))
                             (cpp/exp (* 20 1)))
                          total-distance)
                target (cpp/Vector2MoveTowards p-mouth p-fly length)]]
    ;; outline
    (cpp/DrawLineEx p-mouth target 44 (cpp/GetColor 0x000000ff))
    (cpp/DrawCircleV target 22 (cpp/GetColor 0x000000ff))
    (cpp/DrawCircleV p-mouth 22 (cpp/GetColor 0x000000ff))

    (cpp/DrawLineEx p-mouth target 40 (cpp/GetColor 0xff6464ff))
    (cpp/DrawCircleV target 20 (cpp/GetColor 0xff6464ff))
    (cpp/DrawCircleV p-mouth 20 (cpp/GetColor 0xff6464ff))))

(def fly-flapping-animation {:frame-time 0.05
                             :frames [{:asset :fly-idle-0}
                                      {:asset :fly-idle-1}]})
(defn select-animation-frame [animation time-alive]
  (let [total-anim-time (* (:frame-time animation) (count (:frames animation)))
        animation-segment (cpp/fmod time-alive (float total-anim-time))
        current-frame (int (/ animation-segment (:frame-time animation)))]
    (get-in animation [:frames current-frame :asset])))

(defn draw-flys! [{:keys [flys timer]}]
  (doseq [[_id {p :position r :radius :keys [spawn-time]}] flys
          :let [time-alive (str (- timer spawn-time))
                time-alive (subs time-alive 0 (min (count time-alive) 4))
                text-size 20
                fly-asset (select-animation-frame fly-flapping-animation (- timer spawn-time))]] 
    (cpp/DrawTexture (fly-asset @assets) (int (- (:x p) fly-size)) (int (- (:y p) fly-size)) cpp/WHITE)
    (cpp/DrawText
     time-alive
     (int (- (:x p) r))
     (int (- (:y p) r text-size))
     text-size
     (cpp/GetColor 0xffffffff))))

(defn draw-status! [{:keys [paused? frog-health] :as state}] 
  (let [font-size 40
        frog-health-str (str (max frog-health 0))]
    (cpp/DrawText
     (if paused?
       "PAUSED"
       "PLAYING")
     10
     10
     font-size
     (cpp/GetColor 0xffffffff))
    (cpp/DrawText
     frog-health-str
     (int (- (* 0.5 screen-width)
             (* 0.5 (cpp/MeasureText frog-health-str font-size))))
     10
     font-size
     (cpp/GetColor 0xffffffff))
    (let [font-size (int (* 0.15 screen-width))
          label "GAME OVER"]
      (when (game-over? state)
        (cpp/DrawText
         label
         (int (- (* 0.5 screen-width)
                 (* 0.5 (cpp/MeasureText label font-size))))
         (int (- (* 0.5 screen-height)
                 (* 0.5 font-size)))
         font-size
         (cpp/GetColor 0xffffffff))))
    (let [fps (str (cpp/GetFPS) " FPS")]
      (cpp/DrawText
       fps
       (int (- screen-width
               10
               (cpp/MeasureText fps font-size)))
       10
       font-size
       (cpp/GetColor 0xffffffff)))))

(defn draw-frame! [state]
  (with-scale (/ (float (cpp/GetScreenWidth)) screen-width)
    (cpp/ClearBackground cpp/BLACK)
    (draw-background! state)
    (draw-eyes! state)
    (draw-mouth! state)
    (draw-tongue! state)
    (draw-flys! state)
    (draw-status! state))
  nil)

(defn -main [& args]
  (cpp/SetConfigFlags cpp/FLAG_MSAA_4X_HINT)
  (cpp/InitWindow screen-width screen-height "froggy")
  (load-assets!)
  (cpp/SetTargetFPS 60)
  (cpp/SetExitKey cpp/KEY_NULL)
  (load-gamepad-mappings!)
  (while (cpp/! (cpp/WindowShouldClose))
    (let [next-state (swap! state-atom update-world)]
      (cpp/BeginDrawing)
      (try
        (draw-frame! next-state)
        (catch :default _)))
    (cpp/EndDrawing))
  (cpp/CloseWindow))

(comment
  (def fut (future (-main)))
  (require '[portal.api :as p])
  (p/open {:launcher :auto})
  (add-tap #'p/submit)
  (tap> ::hi))