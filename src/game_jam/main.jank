(ns game-jam.main
  (:require [clojure.string :as str])
  (:include "raylib.h"
            "raygui.h"
            "rlgl.h"
            "raymath.h"
            "game_jam/convert.hpp"))

(defonce assets (atom {}))

(defn load-asset! [{:keys [id path replace]}]
  (let [image (cpp/LoadImage path)]
    (doseq [[from to] replace]
      (cpp/ImageColorReplace (cpp/& image) (cpp/GetColor from) (cpp/GetColor to)))
    (swap! assets assoc id (cpp/LoadTextureFromImage image))
    (cpp/UnloadImage image)))

(defn load-assets! []
  (load-asset! {:id :background_fill
                :path "./resources/background/background_fill.png"
                :replace {0xff0000ff 0x679153ff
                          0x00ff00ff 0x95daf4ff}})
  (load-asset! {:id :background_lines
                :path "./resources/background/background_lines.png"
                :replace {0xff0000ff 0x3e5c30ff
                          0x00ff00ff 0xab5d46ff
                          0x0000ffff 0x278282ff}}))

(defn load-gamepad-mappings! []
  (doseq [mapping (str/split-lines (slurp "./resources/gamepad-mappings.txt"))]
    (cpp/SetGamepadMappings mapping)))

